# /etc/wallmon.env  (chmod 600)
WALLMON_URL=https://your-domain.example/wallmon/status.json
WALLMON_USER=wallmon
WALLMON_PASS=change-me
WALLMON_POLL=30
WALLMON_PORT=8080
# 127.0.0.1 = only this Pi's screen. 0.0.0.0 lets a second device on your LAN
# open http://<pi-ip>:8080/?screen=2 for the second screen.
WALLMON_BIND=127.0.0.1
WALLMON_DASHBOARD=/opt/wallmon/dashboard.json
