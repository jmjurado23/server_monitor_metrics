[Unit]
Description=Wall monitor display server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
EnvironmentFile=/etc/wallmon.env
ExecStart=/usr/bin/python3 /opt/wallmon/wallmon.py
Restart=always
RestartSec=5
# The Pi has 1 GB; this process needs ~20 MB.
MemoryMax=80M

[Install]
WantedBy=multi-user.target
